# Configuración de Entorno para Producción (backend local + túnel ngrok) o Desarrollo
# SQLite local (portátil):
DATABASE_URL="sqlite:///./entrenador_ia.db"
# Si usaras Postgres: "postgresql://usuario:password@host:5432/nombre_db"

STOCKFISH_PATH="stockfish/stockfish.exe"   # Windows: stockfish\stockfish.exe | Linux/Docker: /usr/games/stockfish
GEMINI_API_KEY="tu_gemini_api_key_aqui"
SECRET_KEY="tu_secret_key_jwt_super_segura_aqui"

# Orígenes CORS permitidos, separados por coma.
# Incluye la URL real de tu frontend en Vercel y el dominio ngrok solo si llamas
# a la API desde él mismo (no es necesario para el navegador).
ALLOWED_ORIGINS="https://TU-PROYECTO.vercel.app,http://localhost:3000"

API_V1_STR="/api/v1"
PROJECT_NAME="EntrenadorIA Backend"
LEGAL_VERSION="2026-08-v1"
